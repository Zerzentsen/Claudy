{
  "mcpServers": {

    "google_workspace": {
      "command": "uvx",
      "args": ["--from", "google-workspace-mcp", "google-workspace-worker"],
      "env": {
        "GOOGLE_WORKSPACE_CLIENT_ID": "REMPLACER_PAR_VOTRE_CLIENT_ID.apps.googleusercontent.com",
        "GOOGLE_WORKSPACE_CLIENT_SECRET": "REMPLACER_PAR_VOTRE_CLIENT_SECRET"
      }
    },

    "github": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-e", "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "REMPLACER_PAR_VOTRE_TOKEN"
      }
    }

  }
}
